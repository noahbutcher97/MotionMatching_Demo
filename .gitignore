# Unreal Engine autogenerated files and folders
Binaries/
DerivedDataCache/
Intermediate/
Saved/
.vscode/
.vs/
.idea/

# Compiled build artifacts
*.pdb
*.exe
*.dll
*.lib
*.app
*.dylib
*.so

# Unreal Build Tool / Visual Studio generated files
*.VC.db
*.VC.opendb
*.sln
*.suo
*.user
*.userprefs
*.opensdf
*.sdf
*.cache
*.log
*.tlog

# Crash reports and logs
*.dmp
*.mdmp
*.log

# Configurations that should stay local
*.ini.local
*.ini.bak
*.tmp

# Ignore Rider / JetBrains IDE cache
.idea/
*.iml

# Ignore macOS and Windows junk
.DS_Store
Thumbs.db
desktop.ini

# Ignore Python virtualenvs if using automation
.venv/
env/
__pycache__/
*.pyc

# AI assistant local files, prompts, and agent workspaces
AGENTS.md
CLAUDE.md
GEMINI.md
QWEN.md
AIDER.md
llms.txt
.mcp.json
.mcp.local.json
.uemcp-targets.json
