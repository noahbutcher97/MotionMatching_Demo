# Unreal Engine autogenerated files and folders
Binaries/
DerivedDataCache/
Intermediate/
Saved/
.vscode/
.vs/
.idea/

# Compiled build artifacts
*.pdb
*.exe
*.dll
*.lib
*.app
*.dylib
*.so

# Unreal Build Tool / Visual Studio generated files
*.VC.db
*.VC.opendb
*.sln
*.suo
*.user
*.userprefs
*.opensdf
*.sdf
*.cache
*.log
*.tlog

# Crash reports and logs
*.dmp
*.mdmp
*.log

# Configurations that should stay local
*.ini.local
*.ini.bak
*.tmp

# Ignore Rider / JetBrains IDE cache
.idea/
*.iml

# Ignore macOS and Windows junk
.DS_Store
Thumbs.db
desktop.ini

# Ignore Python virtualenvs if using automation
.venv/
env/
__pycache__/
*.pyc

# Ignore generated project files
*.xcodeproj
*.xcworkspace

# ReasoningEngine ships as a git submodule at Plugins/ReasoningEngine (tracked).
# Only ignore plugin build artifacts; Binaries/ Intermediate/ Saved/ rules above
# already match these at any depth, so nothing extra is needed here.

# Optional: If using git-lfs, don't ignore uasset/umap here
# Instead, track them explicitly:
# git lfs track "*.uasset"
# git lfs track "*.umap"

